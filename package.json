{
  "name": "todo-manager",
  "displayName": "TODO Manager",
  "description": "Simple TODO manager for VS Code",
  "version": "0.0.1",
  "publisher": "tturka",
  "scripts": {
    "build": "tsc -p ./ && copyfiles -u 1 'src/**/*.svg' out"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "todo-manager.scanWorkspace",
        "title": "TODO: Scan workspace"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "workspaceComments",
          "name": "Workspace comments"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "copyfiles": "^2.4.1",
    "typescript": "^7.0.2"
  }
}
