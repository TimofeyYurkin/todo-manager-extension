{
  "name": "todo-manager",
  "displayName": "TODO Manager",
  "description": "Simple TODO manager for VS Code",
  "version": "0.0.1",
  "publisher": "tturka",
  "scripts": {
    "build": "tsc -p ./ && copyfiles -u 1 'src/**/*.svg' out"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "todo-manager.scanWorkspace",
        "title": "Scan Workspace",
        "category": "Todo Manager",
        "icon": {
          "light": "./src/resources/light/sync.svg",
          "dark": "./src/resources/dark/sync.svg"
        }
      },
      {
        "command": "todo-manager.openComment",
        "title": "Open Comment",
        "category": "Todo Manager"
      },
      {
        "command": "todo-manager.removeComment",
        "title": "Remove Comment",
        "category": "Todo Manager"
      },
      {
        "command": "todo-manager.deleteComment",
        "title": "Delete Comment",
        "category": "Todo Manager"
      }
    ],

    "views": {
      "explorer": [
        {
          "id": "todoManager",
          "name": "TODO Manager",
          "icon": ""
        }
      ]
    },

    "viewsWelcome": [
      {
        "view": "todoManager",
        "contents": "No comments have been found.\n[Try to refresh](command:todo-manager.scanWorkspace)"
      }
    ],

    "menus": {
      "view/title": [
        {
          "command": "todo-manager.scanWorkspace",
          "when": "view == todoManager",
          "group": "navigation"
        }
      ],

      "view/item/context": [
        {
          "command": "todo-manager.openComment",
          "when": "view == todoManager && viewItem == comment",
          "group": "commentActions@1"
        },
        {
          "command": "todo-manager.removeComment",
          "when": "view == todoManager && viewItem == comment",
          "group": "commentActions@2"
        },
        {
          "command": "todo-manager.deleteComment",
          "when": "view == todoManager && viewItem == comment",
          "group": "commentActions@3"
        }
      ],

      "commandPalette": [
        {
          "command": "todo-manager.openComment",
          "when": "false"
        },
        {
          "command": "todo-manager.removeComment",
          "when": "false"
        },
        {
          "command": "todo-manager.deleteComment",
          "when": "false"
        }
      ]
    },

    "configuration": [
      {
        "title": "TODO Manager",
        "properties": {
          "todoManager.highlightComments": {
            "type": "boolean",
            "default": true,
            "description": "Enables or disables comment highlighting in the editor"
          },
          "todoManager.showCommentGroupIcons": {
            "type": "boolean",
            "default": true,
            "description": "Enables or disables icons for group UI elements"
          }
        }
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "copyfiles": "^2.4.1",
    "typescript": "^7.0.2"
  }
}
