{
  "name": "todo-manager",
  "displayName": "TODO Manager",
  "description": "Simple TODO manager for VS Code",
  "version": "0.0.1",
  "publisher": "tturka",
  "scripts": {
    "build": "tsc -p ./ && copyfiles -u 1 'src/**/*.svg' out"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "todo-manager.scanWorkspace",
        "title": "TODO: Scan Workspace",
        "icon": {
          "light": "./src/resources/light/sync.svg",
          "dark": "./src/resources/dark/sync.svg"
        }
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "todoManager",
          "name": "TODO Manager",
          "icon": ""
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "todoManager",
        "contents": "No comments have been found.\n[Try to refresh](command:todo-manager.scanWorkspace)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "todo-manager.scanWorkspace",
          "when": "view == todoManager",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "copyfiles": "^2.4.1",
    "typescript": "^7.0.2"
  }
}
