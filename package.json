{
  "name": "TODO manager",
  "version": "0.0.1",
  "scripts": {
    "build": "tsc -p ./"
  },
  "main": "./out/extension.js",
  "engines": {
    "vscode": "^1.105.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "todo-manager.scanWorkspace",
        "title": "TODO: Scan workspace"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "^1.138.0",
    "typescript": "^7.0.2"
  }
}
